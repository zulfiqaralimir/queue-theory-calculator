# Queue Theory Calculator - .gitignore

# ============================================
# MOBILE (Flutter)
# ============================================

# Flutter/Dart/Pub related
**/mobile/.dart_tool/
**/mobile/.flutter-plugins
**/mobile/.flutter-plugins-dependencies
**/mobile/.packages
**/mobile/.pub-cache/
**/mobile/.pub/
**/mobile/build/
**/mobile/flutter_*.png
**/mobile/linked_*.ds
**/mobile/unlinked.ds
**/mobile/unlinked_spec.ds

# Android related
**/mobile/android/**/gradle-wrapper.jar
**/mobile/android/.gradle
**/mobile/android/captures/
**/mobile/android/gradlew
**/mobile/android/gradlew.bat
**/mobile/android/local.properties
**/mobile/android/**/GeneratedPluginRegistrant.java
**/mobile/android/key.properties
**/mobile/*.jks

# iOS/XCode related
**/mobile/ios/**/*.mode1v3
**/mobile/ios/**/*.mode2v3
**/mobile/ios/**/*.moved-aside
**/mobile/ios/**/*.pbxuser
**/mobile/ios/**/*.perspectivev3
**/mobile/ios/**/*sync/
**/mobile/ios/**/.sconsign.dblite
**/mobile/ios/**/.tags*
**/mobile/ios/**/.vagrant/
**/mobile/ios/**/DerivedData/
**/mobile/ios/**/Icon?
**/mobile/ios/**/Pods/
**/mobile/ios/**/.symlinks/
**/mobile/ios/**/profile
**/mobile/ios/**/xcuserdata
**/mobile/ios/.generated/
**/mobile/ios/Flutter/App.framework
**/mobile/ios/Flutter/Flutter.framework
**/mobile/ios/Flutter/Flutter.podspec
**/mobile/ios/Flutter/Generated.xcconfig
**/mobile/ios/Flutter/app.flx
**/mobile/ios/Flutter/app.zip
**/mobile/ios/Flutter/flutter_assets/
**/mobile/ios/Flutter/flutter_export_environment.sh
**/mobile/ios/ServiceDefinitions.json
**/mobile/ios/Runner/GeneratedPluginRegistrant.*

# ============================================
# WEB
# ============================================

**/web/node_modules/
**/web/dist/
**/web/build/
**/web/.cache/
**/web/*.log
**/web/.env
**/web/.env.local
**/web/.env.*.local

# ============================================
# PYTHON
# ============================================

**/python/__pycache__/
**/python/*.py[cod]
**/python/*$py.class
**/python/*.so
**/python/.Python
**/python/env/
**/python/venv/
**/python/ENV/
**/python/env.bak/
**/python/venv.bak/
**/python/.pytest_cache/
**/python/.coverage
**/python/htmlcov/
**/python/dist/
**/python/build/
**/python/*.egg-info/

# ============================================
# GENERAL
# ============================================

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local
secrets.json
config.local.json

# API Keys & Credentials (NEVER COMMIT THESE!)
**/api_keys.json
**/credentials.json
**/service_account.json
**/*-credentials.json
**/*.pem
**/*.key
**/*.cert

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Build outputs (platform specific)
*.apk
*.aab
*.ipa
*.app

# Documentation builds
**/docs/_build/
**/docs/.doctrees/

# Test coverage
coverage/
.nyc_output/

# Dependency directories
node_modules/
vendor/

# Package files
*.tar.gz
*.zip
*.rar

# ============================================
# PROJECT SPECIFIC
# ============================================

# User data (if storing locally)
**/user_data/
**/customer_data/

# Revenue/Analytics data
**/analytics/
**/revenue_data/

# Deployment scripts with secrets
**/deploy_prod.sh

# ============================================
# KEEP THESE (force include)
# ============================================
!**/assets/.gitkeep
!**/docs/.gitkeep
